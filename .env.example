# =============================================================================
# Hull Tactical — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# =============================================================================

# --- Kaggle API ---
KAGGLE_USERNAME=username_kaggle
KAGGLE_KEY=kaggle_key

# --- MLflow / DagsHub (remote, used by CI and standalone docker-compose) ---
MLFLOW_TRACKING_URI=https://dagshub.com/username_dagshub/hull-tactical-market-prediction.mlflow/
DAGSHUB_USERNAME=username_dagshub
DAGSHUB_TOKEN=dagshub_token
MLFLOW_TRACKING_USERNAME=${DAGSHUB_USERNAME}
MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}

# --- Streamlit ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# --- Python ---
PYTHONPATH=/app
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# =============================================================================
# Airflow full-stack (docker-compose.airflow.yml)
# =============================================================================

# PostgreSQL — shared by Airflow metadata DB and MLflow backend store
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_secret_change_me
POSTGRES_DB=airflow

# Airflow security keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here

# Airflow admin user (created by airflow-init service on first run)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_secret_change_me

# NewsAPI (https://newsapi.org — free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# ChromaDB (set automatically in docker-compose.airflow.yml — override if external)
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
