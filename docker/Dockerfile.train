# Hull Tactical Market Prediction - Training Dockerfile
FROM python:3.12-slim

LABEL maintainer="Hull Tactical Team"
LABEL description="Hull Tactical Training Pipeline"

# Set working directory
WORKDIR /app
# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (kaggle already included in requirements.txt)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ src/
COPY configs/ configs/
COPY scripts/ scripts/

# Create directories
RUN mkdir -p artifacts/data artifacts/models artifacts/logs

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Create Kaggle config directory
RUN mkdir -p /root/.kaggle

# Default command - run training script
CMD ["python", "scripts/train.py"]
